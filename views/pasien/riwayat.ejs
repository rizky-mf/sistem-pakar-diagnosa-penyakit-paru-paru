<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="mb-0">Riwayat Diagnosa Saya</h3>
  <a href="/diagnosa" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Diagnosa Baru</a>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead><tr><th>Tanggal</th><th>Jumlah Gejala</th><th>Hasil</th><th class="text-end">Aksi</th></tr></thead>
      <tbody>
        <% if (!riwayat.length) { %>
          <tr><td colspan="4" class="text-center text-muted">Anda belum pernah melakukan diagnosa.</td></tr>
        <% } %>
        <% riwayat.forEach(r => { %>
          <tr>
            <td class="text-nowrap"><%= new Date(r.createdAt).toLocaleString('id-ID') %></td>
            <td><%= r.gejala.length %></td>
            <td><%= r.hasil.diagnosa.map(d => d.nama).join(', ') || 'Tidak ada aturan terpenuhi' %></td>
            <td class="text-end"><a href="/diagnosa/hasil/<%= r.id %>" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i> Lihat</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
