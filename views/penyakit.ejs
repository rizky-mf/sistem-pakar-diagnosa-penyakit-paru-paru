<%- include('partials/header') %>

<div class="page-header">
  <div>
    <span class="eyebrow mb-2"><i class="bi bi-book"></i> Ensiklopedia</span>
    <h1 class="page-title mt-2">Informasi Penyakit Paru-Paru</h1>
    <p class="page-subtitle">Kenali penyakit paru yang ada di basis pengetahuan beserta penanganannya.</p>
  </div>
  <div class="input-icon" style="min-width: min(100%, 18rem)">
    <i class="bi bi-search"></i>
    <input type="search" class="form-control" placeholder="Cari penyakit..." data-filter="#daftarPenyakit" data-filter-empty="#penyakitKosong" aria-label="Cari penyakit">
  </div>
</div>

<div class="row g-3" id="daftarPenyakit">
  <% penyakit.forEach((p, i) => { %>
    <div class="col-md-6 col-xl-4" data-filter-item data-search="<%= p.kode %> <%= p.nama %>">
      <div class="card card-hover h-100">
        <div class="card-body d-flex flex-column">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="icon-tile <%= ['tone-teal', 'tone-sky', 'tone-violet', 'tone-amber', 'tone-rose'][i % 5] %>"><i class="bi bi-lungs"></i></div>
            <div>
              <span class="badge badge-code"><%= p.kode %></span>
              <h5 class="fw-bold mb-0 mt-1"><%= p.nama %></h5>
            </div>
          </div>
          <p class="text-muted clamp-3 mb-3"><%= p.deskripsi %></p>
          <button type="button" class="btn btn-soft mt-auto align-self-start"
                  data-bs-toggle="modal" data-bs-target="#detailModal"
                  data-kode="<%= p.kode %>" data-nama="<%= p.nama %>"
                  data-deskripsi="<%= p.deskripsi %>" data-solusi="<%= p.solusi %>">
            Selengkapnya <i class="bi bi-arrow-right"></i>
          </button>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<div class="card" id="penyakitKosong" <%= penyakit.length ? 'hidden' : '' %>>
  <div class="empty-state">
    <div class="icon-tile lg tone-sky"><i class="bi bi-search"></i></div>
    <h6>Penyakit tidak ditemukan</h6>
    <p class="mb-0">Coba kata kunci lain.</p>
  </div>
</div>

<div class="modal fade" id="detailModal" tabindex="-1" aria-labelledby="detailJudul" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
    <div class="modal-content">
      <div class="modal-header border-0 pb-0 px-4 pt-4">
        <div>
          <span class="badge badge-code" data-field="kode"></span>
          <h4 class="fw-bold mt-2 mb-0" id="detailJudul" data-field="nama"></h4>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
      </div>
      <div class="modal-body px-4 pb-4">
        <h6 class="fw-bold mt-2"><i class="bi bi-info-circle text-primary me-1"></i> Deskripsi</h6>
        <p class="text-muted" data-field="deskripsi"></p>
        <h6 class="fw-bold mt-4"><i class="bi bi-heart-pulse text-primary me-1"></i> Penanganan</h6>
        <p class="text-muted mb-0" data-field="solusi"></p>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
