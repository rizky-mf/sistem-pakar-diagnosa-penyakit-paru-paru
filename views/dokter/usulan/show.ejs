<%- include('../../partials/header') %>
<%
  const STATUS = {
    menunggu: ['Menunggu validasi', 'bg-warning-subtle text-warning-emphasis'],
    disetujui: ['Disetujui', 'bg-success-subtle text-success-emphasis'],
    ditolak: ['Ditolak', 'bg-danger-subtle text-danger-emphasis'],
  };
  const [teksStatus, kelasStatus] = STATUS[usulan.status];
  const waktu = t => new Date(t).toLocaleString('id-ID', { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  const bisaUbah = milikSendiri && usulan.status !== 'disetujui';
%>

<div class="page-header">
  <div>
    <a href="/dokter/usulan" class="small text-muted text-decoration-none"><i class="bi bi-arrow-left"></i> <%= isKetua ? 'Validasi Usulan' : 'Usulan Saya' %></a>
    <h1 class="page-title mt-1"><%= ubah ? 'Usulan perubahan' : 'Usulan tambah' %> <%= label.toLowerCase() %> <span class="badge badge-code neutral align-middle"><%= usulan.kode %></span></h1>
    <p class="page-subtitle"><span class="badge <%= kelasStatus %>"><%= teksStatus %></span></p>
  </div>
  <% if (bisaUbah || isKetua) { %>
    <div class="d-flex gap-2">
      <% if (bisaUbah) { %>
        <a href="/dokter/usulan/<%= jenis %>/<%= usulan.id %>/edit" class="btn btn-ghost"><i class="bi bi-pencil"></i> Edit usulan</a>
      <% } %>
      <form action="/dokter/usulan/<%= jenis %>/<%= usulan.id %>?_method=DELETE" method="POST" data-confirm="Usulan <%= usulan.kode %> akan dihapus.">
        <button class="btn btn-ghost danger"><i class="bi bi-trash3"></i> Hapus</button>
      </form>
    </div>
  <% } %>
</div>

<div class="row g-4">
  <div class="col-lg-8">
    <div class="card">
      <div class="card-header"><%= ubah ? 'Perbandingan data saat ini dan usulan' : 'Isi usulan' %></div>
      <div class="table-responsive">
        <table class="table table-modern mb-0">
          <thead>
            <tr>
              <th style="width: 11rem">Kolom</th>
              <% if (ubah) { %><th>Data saat ini</th><% } %>
              <th><%= ubah ? 'Usulan' : 'Isi' %></th>
            </tr>
          </thead>
          <tbody>
            <% baris.forEach(([kolom, lama, baru]) => { const berubah = ubah && String(lama) !== String(baru); %>
              <tr>
                <td class="fw-semibold small"><%= kolom %></td>
                <% if (ubah) { %><td class="small text-muted"><%= lama || '-' %></td><% } %>
                <td class="small <%= berubah ? 'fw-semibold text-primary' : '' %>">
                  <%= baru || '-' %>
                  <% if (berubah) { %><span class="badge bg-primary-subtle text-primary-emphasis ms-1">berubah</span><% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <% if (ubah && usulan.status === 'disetujui') { %>
      <p class="text-muted small mt-2 mb-0"><i class="bi bi-info-circle me-1"></i>Usulan sudah diterapkan, sehingga kolom "Data saat ini" sudah berisi data hasil perubahan.</p>
    <% } %>
  </div>

  <div class="col-lg-4">
    <div class="card mb-3">
      <div class="card-body">
        <dl class="info-list mb-0">
          <dt>Pengusul</dt><dd><%= usulan.pengusul ? usulan.pengusul.nama : '-' %></dd>
          <dt>Diajukan</dt><dd><%= waktu(usulan.updatedAt) %></dd>
          <% if (usulan.status !== 'menunggu') { %>
            <dt>Divalidasi oleh</dt><dd><%= usulan.validator ? usulan.validator.nama : '-' %></dd>
            <dt>Tanggal validasi</dt><dd><%= usulan.tanggalValidasi ? waktu(usulan.tanggalValidasi) : '-' %></dd>
          <% } %>
        </dl>
        <% if (usulan.catatan) { %>
          <div class="alert <%= usulan.status === 'ditolak' ? 'alert-danger' : 'alert-secondary' %> small mt-3 mb-0">
            <div class="fw-semibold mb-1">Catatan dokter ketua</div><%= usulan.catatan %>
          </div>
        <% } %>
      </div>
    </div>

    <% if (isKetua && usulan.status === 'menunggu') { %>
      <div class="card">
        <div class="card-header">Validasi</div>
        <div class="card-body">
          <form method="POST" id="formValidasi">
            <label class="form-label small" for="catatan">Catatan <span class="text-muted">(wajib jika ditolak)</span></label>
            <textarea class="form-control mb-3" id="catatan" name="catatan" rows="3" placeholder="Alasan atau masukan untuk pengusul"></textarea>
            <div class="d-grid gap-2">
              <button class="btn btn-primary" formaction="/dokter/usulan/<%= jenis %>/<%= usulan.id %>/setujui"><i class="bi bi-check2-circle"></i> Setujui &amp; terapkan</button>
              <button class="btn btn-ghost danger" formaction="/dokter/usulan/<%= jenis %>/<%= usulan.id %>/tolak"><i class="bi bi-x-circle"></i> Tolak</button>
            </div>
          </form>
        </div>
      </div>
    <% } %>
  </div>
</div>

<%- include('../../partials/footer') %>
