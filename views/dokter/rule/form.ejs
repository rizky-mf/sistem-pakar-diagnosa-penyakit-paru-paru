<%- include('../../partials/header') %>
<%- include('../../partials/dokter-nav') %>

<h4 class="mb-3"><%= title %></h4>

<div class="card">
  <div class="card-body">
    <form action="<%= action %>" method="POST">
      <div class="row g-3">
        <div class="col-md-3">
          <label class="form-label" for="kode">Kode Aturan</label>
          <input class="form-control" id="kode" name="kode" value="<%= item.kode || '' %>" placeholder="R09" maxlength="10" required>
        </div>
        <div class="col-md-9">
          <label class="form-label" for="penyakitId">THEN (Penyakit)</label>
          <select class="form-select" id="penyakitId" name="penyakitId" required>
            <option value="">-- Pilih penyakit --</option>
            <% penyakit.forEach(p => { %>
              <option value="<%= p.id %>" <%= item.penyakitId === p.id ? 'selected' : '' %>><%= p.kode %> - <%= p.nama %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-12">
          <label class="form-label">IF (Gejala, digabung dengan AND)</label>
          <div class="row border rounded p-2 mx-0">
            <% gejala.forEach(g => { %>
              <div class="col-md-6">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="gejala" value="<%= g.id %>" id="g<%= g.id %>"
                    <%= item.gejalaIds.includes(g.id) ? 'checked' : '' %>>
                  <label class="form-check-label" for="g<%= g.id %>">
                    <span class="text-muted small"><%= g.kode %></span> &middot; <%= g.nama %>
                  </label>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      </div>
      <div class="mt-3">
        <button class="btn btn-primary" type="submit">Simpan</button>
        <a href="/dokter/rule" class="btn btn-outline-secondary">Batal</a>
      </div>
    </form>
  </div>
</div>

<%- include('../../partials/footer') %>
