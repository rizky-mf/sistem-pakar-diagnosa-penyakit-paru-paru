<%- include('../../partials/header') %>

<div class="page-header">
  <div>
    <a href="/dokter/rule" class="small text-muted text-decoration-none"><i class="bi bi-arrow-left"></i> Aturan</a>
    <h1 class="page-title mt-1"><%= title %></h1>
    <p class="page-subtitle">Penyakit disimpulkan jika <strong>semua</strong> gejala yang dipilih terpenuhi.</p>
  </div>
</div>

<form action="<%= action %>" method="POST">
  <div class="row g-4">
    <div class="col-lg-4 order-lg-last">
      <div class="card">
        <div class="card-body">
          <div class="mb-3">
            <label class="form-label" for="kode">Kode aturan</label>
            <input class="form-control font-monospace" id="kode" name="kode" value="<%= item.kode || '' %>" placeholder="R09" maxlength="10" required>
          </div>
          <div class="mb-3">
            <label class="form-label" for="penyakitId"><span class="text-primary fw-800">THEN</span> &mdash; penyakit</label>
            <select class="form-select" id="penyakitId" name="penyakitId" required>
              <option value="">Pilih penyakit</option>
              <% penyakit.forEach(p => { %>
                <option value="<%= p.id %>" <%= item.penyakitId === p.id ? 'selected' : '' %>><%= p.kode %> &middot; <%= p.nama %></option>
              <% }) %>
            </select>
          </div>
          <div class="d-flex justify-content-between align-items-center p-3 rounded-3 mb-3" style="background: var(--surface-2)">
            <span class="small text-muted">Gejala dipilih</span>
            <span class="fw-800 fs-5 text-primary" data-count-checked='#daftarGejala input[name="gejala"]'>0</span>
          </div>
          <div class="d-grid gap-2">
            <button class="btn btn-primary" type="submit"><i class="bi bi-check-lg"></i> Simpan Aturan</button>
            <a href="/dokter/rule" class="btn btn-ghost">Batal</a>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-8">
      <div class="card">
        <div class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center">
          <span><span class="text-primary fw-800">IF</span> &mdash; gejala (digabung dengan AND)</span>
          <div class="input-icon" style="min-width: min(100%, 14rem)">
            <i class="bi bi-search"></i>
            <input type="search" class="form-control form-control-sm" placeholder="Cari gejala..." data-filter="#daftarGejala" aria-label="Cari gejala">
          </div>
        </div>
        <div class="card-body">
          <div class="row g-2" id="daftarGejala">
            <% gejala.forEach(g => { %>
              <div class="col-md-6" data-filter-item data-search="<%= g.kode %> <%= g.nama %>">
                <label class="gejala-card" for="g<%= g.id %>">
                  <input class="form-check-input" type="checkbox" name="gejala" value="<%= g.id %>" id="g<%= g.id %>"
                    <%= item.gejalaIds.includes(g.id) ? 'checked' : '' %>>
                  <span>
                    <span class="gejala-kode"><%= g.kode %></span>
                    <span class="gejala-nama"><%= g.nama %></span>
                  </span>
                </label>
              </div>
            <% }) %>
          </div>
        </div>
      </div>
    </div>
  </div>
</form>

<%- include('../../partials/footer') %>
