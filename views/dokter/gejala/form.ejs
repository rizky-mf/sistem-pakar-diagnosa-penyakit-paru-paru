<%- include('../../partials/header') %>

<div class="page-header">
  <div>
    <a href="/dokter/gejala" class="small text-muted text-decoration-none"><i class="bi bi-arrow-left"></i> Data Gejala</a>
    <h1 class="page-title mt-1"><%= title %></h1>
  </div>
</div>

<div class="row">
  <div class="col-xl-8">
    <div class="card">
      <div class="card-body p-4">
        <form action="<%= action %>" method="POST">
          <div class="row g-3">
            <div class="col-md-3">
              <label class="form-label" for="kode">Kode</label>
              <input class="form-control font-monospace" id="kode" name="kode" value="<%= item.kode || '' %>" placeholder="G26" maxlength="10" required>
            </div>
            <div class="col-md-9">
              <label class="form-label" for="nama">Nama gejala</label>
              <input class="form-control" id="nama" name="nama" value="<%= item.nama || '' %>" placeholder="contoh: Batuk lebih dari 2 minggu" required>
              <div class="form-hint">Tulis dengan bahasa yang mudah dipahami pasien.</div>
            </div>
          </div>
          <hr class="my-4">
          <div class="d-flex gap-2 justify-content-end">
            <a href="/dokter/gejala" class="btn btn-ghost">Batal</a>
            <button class="btn btn-primary" type="submit"><i class="bi bi-check-lg"></i> Simpan</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../../partials/footer') %>
