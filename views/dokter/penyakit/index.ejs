<%- include('../../partials/header') %>

<div class="page-header">
  <div>
    <h1 class="page-title">Data Penyakit</h1>
    <p class="page-subtitle">Konklusi (THEN) yang dapat disimpulkan oleh sistem.</p>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <div class="input-icon" style="min-width: min(100%, 15rem)">
      <i class="bi bi-search"></i>
      <input type="search" class="form-control" placeholder="Cari penyakit..." data-filter="#tabelPenyakit" data-filter-empty="#penyakitKosong" aria-label="Cari penyakit">
    </div>
    <a href="/dokter/penyakit/tambah" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Tambah</a>
  </div>
</div>

<div class="card card-table">
  <% if (!penyakit.length) { %>
    <div class="empty-state">
      <div class="icon-tile lg tone-teal"><i class="bi bi-virus"></i></div>
      <h6>Belum ada data penyakit</h6>
      <a href="/dokter/penyakit/tambah" class="btn btn-primary btn-sm mt-2">Tambah Penyakit</a>
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="table table-modern">
        <thead><tr><th>Kode</th><th>Penyakit</th><th class="d-none d-md-table-cell">Deskripsi</th><th class="text-end">Aksi</th></tr></thead>
        <tbody id="tabelPenyakit">
          <% penyakit.forEach(p => { %>
            <tr data-filter-item data-search="<%= p.kode %> <%= p.nama %>">
              <td><span class="badge badge-code"><%= p.kode %></span></td>
              <td class="cell-title"><%= p.nama %></td>
              <td class="d-none d-md-table-cell text-muted small" style="max-width: 28rem"><span class="clamp-3"><%= p.deskripsi %></span></td>
              <td class="text-end text-nowrap">
                <a href="/dokter/penyakit/<%= p.id %>/edit" class="btn btn-ghost btn-icon btn-sm" aria-label="Edit"><i class="bi bi-pencil"></i></a>
                <form action="/dokter/penyakit/<%= p.id %>?_method=DELETE" method="POST" class="d-inline"
                      data-confirm="Penyakit <%= p.kode %> - <%= p.nama %> beserta seluruh aturannya akan dihapus.">
                  <button class="btn btn-ghost btn-icon btn-sm danger" aria-label="Hapus"><i class="bi bi-trash3"></i></button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <div class="empty-state py-4" id="penyakitKosong" hidden>
      <h6 class="mb-1">Penyakit tidak ditemukan</h6>
      <p class="mb-0 small">Coba kata kunci lain.</p>
    </div>
  <% } %>
</div>

<%- include('../../partials/footer') %>
