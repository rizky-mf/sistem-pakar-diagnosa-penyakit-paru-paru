<%- include('../partials/header') %>
<%
  // diagnosa, lainnya, jejak, jumlahIterasi disiapkan oleh controller (helpers.dataHasil)
  const namaGejala = Object.fromEntries(riwayat.daftarGejala.map(g => [g.kode, g.nama]));
  const namaPenyakit = Object.fromEntries([...diagnosa, ...lainnya].map(d => [d.kode, d.nama]));
  const tanggal = new Date(riwayat.tanggalDiagnosa);
  const waktuDiagnosa = tanggal.toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) + ', ' +
    tanggal.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) + ' WIB';
  const labelKeyakinan = Object.fromEntries(tingkatKeyakinan.map(t => [t.nilai, t.label]));
  const angka = n => Number(n).toLocaleString('id-ID', { maximumFractionDigits: 4 });
  const persen = n => Number(n).toLocaleString('id-ID', { maximumFractionDigits: 2 });
  const perhitungan = [...diagnosa, ...lainnya].filter(d => d.langkah.length);
  // Pasien hanya melihat inti hasil; rincian teknis (kemungkinan lain, perhitungan CF,
  // jejak forward chaining) hanya untuk dokter dan admin.
  const lihatDetail = user && user.role !== 'pasien';
%>

<% if (user && user.role === 'pasien') { %>
  <%- include('../partials/stepper', { langkah: 4 }) %>
<% } %>

<%
  const lahir = riwayat.user ? new Date(riwayat.user.tanggalLahir) : null;
  const tglPanjang = t => t.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
  const utama = diagnosa[0];
%>
<%# Lembar cetak: hanya tampil saat halaman dicetak %>
<div class="surat-cetak d-none d-print-block">
  <i class="bi bi-lungs surat-watermark" aria-hidden="true"></i>

  <header class="surat-kop">
    <span class="brand-logo"><i class="bi bi-lungs"></i></span>
    <div>
      <div class="surat-brand">SiPakar Paru</div>
      <div class="surat-tagline">Sistem Pakar Diagnosa Penyakit Paru-Paru</div>
    </div>
    <div class="surat-nomor">No. Hasil<br><strong>#<%= String(riwayat.id).padStart(5, '0') %></strong></div>
  </header>

  <h2 class="surat-judul">Informasi Pasien</h2>
  <div class="surat-grid">
    <span class="surat-label">ID Pasien</span><span class="surat-isi"><%= riwayat.kodePasien || '-' %></span>
    <span class="surat-label">Nama Pasien</span><span class="surat-isi"><%= riwayat.nama %></span>
    <span class="surat-label">Jenis Kelamin</span><span class="surat-isi"><%= riwayat.jenisKelamin === 'L' ? 'Laki-laki' : 'Perempuan' %></span>
    <span class="surat-label">Tanggal Lahir</span><span class="surat-isi"><%= lahir ? tglPanjang(lahir) : '-' %></span>
    <span class="surat-label">Umur</span><span class="surat-isi"><%= riwayat.umur %> tahun</span>
  </div>

  <h2 class="surat-judul">Catatan</h2>
  <p>Tanggal diagnosa keluar: <strong><%= waktuDiagnosa %></strong></p>
  <p>Untuk perhatian,</p>
  <% if (utama) { %>
    <p class="surat-teks">
      Kami informasikan bahwa pasien di atas kemungkinan didiagnosa: <strong><%= utama.nama %></strong>
      dengan tingkat kepastian <strong><%= persen(utama.persen) %>% (<%= utama.interpretasi %>)</strong>.
      Diagnosa tersebut diberikan atas <%= riwayat.daftarGejala.length %> gejala yang dipilih pasien pada saat pemeriksaan.
    </p>
  <% } else { %>
    <p class="surat-teks">
      Berdasarkan <%= riwayat.daftarGejala.length %> gejala yang dipilih pasien pada saat pemeriksaan, sistem belum dapat
      menyimpulkan penyakit paru-paru tertentu. Jika keluhan berlanjut, pasien disarankan berkonsultasi langsung ke dokter.
    </p>
  <% } %>

  <% if (utama) { %>
    <h2 class="surat-judul">Hasil Diagnosa dan Saran Penanganan</h2>
    <div class="surat-grid surat-grid-1">
      <span class="surat-label">Penyakit</span><span class="surat-isi"><%= utama.nama %> (<%= utama.kode %>)</span>
      <span class="surat-label">Tingkat Kepastian</span><span class="surat-isi"><%= persen(utama.persen) %>% &middot; <%= utama.interpretasi %></span>
      <span class="surat-label">Keterangan</span><span class="surat-isi"><%= utama.deskripsi %></span>
      <span class="surat-label">Saran Penanganan</span><span class="surat-isi"><%= utama.solusi %></span>
    </div>
  <% } %>

  <p class="surat-teks mt-4">Demikian informasi dari kami, semoga dapat menjadi bahan pertimbangan.</p>

  <div class="surat-ttd">
    <div class="fw-bold">Diagnosa Oleh</div>
    <div class="fw-bold mt-3">Sistem Pakar SiPakar Paru</div>
    <div>Metode Forward Chaining &amp; Certainty Factor</div>
  </div>

  <footer class="surat-kaki">
    Dokumen ini merupakan hasil diagnosa awal dari sistem pakar dan bukan pengganti pemeriksaan dokter.
    Bawa dokumen ini saat berkonsultasi dengan dokter.
  </footer>
</div>

<div class="d-print-none">
<div class="page-header">
  <div>
    <h1 class="page-title">Hasil Diagnosa</h1>
    <p class="page-subtitle"><i class="bi bi-calendar3 me-1"></i>Diagnosa keluar: <time datetime="<%= tanggal.toISOString() %>"><%= waktuDiagnosa %></time></p>
  </div>
  <div class="d-flex gap-2 no-print">
    <a href="<%= kembali %>" class="btn btn-ghost"><i class="bi bi-arrow-left"></i> Kembali</a>
    <button type="button" onclick="window.print()" class="btn btn-primary"><i class="bi bi-printer"></i> Cetak</button>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-8">

    <% if (diagnosa.length) { %>
      <% diagnosa.forEach((d, i) => { %>
        <div class="result-hero mb-3">
          <div class="d-flex align-items-center gap-2">
            <span class="label">Terindikasi</span>
            <span class="badge badge-glass"><%= d.kode %></span>
          </div>
          <h2><%= d.nama %></h2>
          <div class="my-3">
            <div class="small opacity-75">Tingkat kepastian diagnosa</div>
            <div class="fs-1 fw-800 lh-1 my-1"><%= persen(d.persen) %>%</div>
            <div class="small fw-semibold"><%= d.interpretasi %><% if (lihatDetail && d.total) { %> &middot; <%= d.cocok %>/<%= d.total %> gejala aturan <%= d.rule %> cocok<% } %></div>
          </div>
          <p><%= d.deskripsi %></p>
        </div>
        <div class="card mb-4">
          <div class="card-body solusi-box">
            <div class="icon-tile tone-teal"><i class="bi bi-heart-pulse"></i></div>
            <div>
              <h6 class="fw-bold mb-1">Saran penanganan</h6>
              <p class="text-muted mb-0"><%= d.solusi %></p>
            </div>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="card mb-4">
        <div class="empty-state">
          <div class="icon-tile lg tone-amber"><i class="bi bi-question-circle"></i></div>
          <h6>Belum ada penyakit yang dapat disimpulkan</h6>
          <p class="mb-0 mx-auto" style="max-width: 32rem">Gejala yang dipilih tidak cocok dengan aturan penyakit mana pun di basis pengetahuan. Jika keluhan berlanjut, segera konsultasikan ke dokter.</p>
        </div>
      </div>
    <% } %>

    <% if (lihatDetail) { %>
    <% if (lainnya.length) { %>
      <div class="card mb-4">
        <div class="card-header d-flex align-items-center gap-2">
          <i class="bi bi-activity text-warning"></i> Kemungkinan lain
        </div>
        <div class="card-body d-flex flex-column gap-3">
          <% lainnya.forEach(p => { %>
            <div>
              <div class="d-flex justify-content-between gap-2 small mb-1">
                <span class="fw-semibold"><%= p.nama %> <span class="text-muted fw-normal">&middot; <%= p.interpretasi %></span></span>
                <span class="text-muted text-nowrap"><%= p.cocok %>/<%= p.total %> gejala &middot; <strong style="color: var(--ink)"><%= persen(p.persen) %>%</strong></span>
              </div>
              <div class="progress" style="height: 8px" role="progressbar" aria-label="Tingkat kepastian <%= p.nama %>" aria-valuenow="<%= p.persen %>" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar" <%- `style="width: ${Number(p.persen)}%"` %>></div>
              </div>
            </div>
          <% }) %>
          <p class="text-muted small mb-0"><i class="bi bi-info-circle me-1"></i>Persentase adalah tingkat kepastian (certainty factor) dari gejala yang cocok dengan aturan penyakit tersebut.</p>
        </div>
      </div>
    <% } %>

    <% if (perhitungan.length) { %>
      <div class="card mb-4">
        <div class="card-header d-flex align-items-center gap-2">
          <i class="bi bi-calculator text-primary"></i> Perhitungan certainty factor
        </div>
        <div class="card-body d-flex flex-column gap-4">
          <% perhitungan.forEach((d, i) => { %>
            <details <%= i === 0 ? 'open' : '' %>>
              <summary class="fw-semibold mb-2" style="cursor: pointer"><%= d.nama %> <span class="text-muted fw-normal small">&middot; Aturan <%= d.rule %> &middot; <%= persen(d.persen) %>%</span></summary>
              <div class="table-responsive">
                <table class="table table-sm table-modern mb-2">
                  <thead>
                    <tr>
                      <th>Gejala</th>
                      <th class="text-end">CF pakar</th>
                      <th class="text-end">CF user</th>
                      <th class="text-end">CF gejala</th>
                      <th class="text-end">CF kombinasi</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% d.langkah.forEach(l => { %>
                      <tr>
                        <td><span class="badge badge-code neutral" title="<%= namaGejala[l.kode] || namaPenyakit[l.kode] || l.kode %>"><%= l.kode %></span></td>
                        <td class="text-end"><%= angka(l.cfPakar) %></td>
                        <td class="text-end"><%= angka(l.cfUser) %></td>
                        <td class="text-end"><%= angka(l.cfGejala) %></td>
                        <td class="text-end fw-semibold"><%= angka(l.cfKombinasi) %></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
              <div class="small">CF akhir = <strong><%= angka(d.cf) %></strong> (<%= persen(d.persen) %>%) &rarr; <%= d.interpretasi %></div>
            </details>
          <% }) %>
          <p class="text-muted small mb-0"><i class="bi bi-info-circle me-1"></i>CF gejala = CF pakar &times; CF user. CF kombinasi = CF lama + CF gejala &times; (1 &minus; CF lama).</p>
        </div>
      </div>
    <% } %>

    <div class="card">
      <div class="card-header d-flex align-items-center gap-2">
        <i class="bi bi-diagram-3 text-primary"></i> Jejak penalaran forward chaining
      </div>
      <div class="card-body">
        <% if (jejak.length) { %>
          <ol class="timeline">
            <% jejak.forEach(j => { %>
              <li>
                <div class="tl-meta">Iterasi <%= j.iterasi %> &middot; Aturan <%= j.rule %> terpenuhi</div>
                <div class="rule-expr">
                  <span class="kw">IF</span>
                  <% j.premis.forEach((k, i) => { %>
                    <% if (i) { %><span class="kw">AND</span><% } %>
                    <span class="badge badge-code neutral" title="<%= namaGejala[k] || k %>"><%= k %></span>
                  <% }) %>
                  <span class="kw">THEN</span>
                  <span class="badge badge-code" title="<%= namaPenyakit[j.konklusi] || j.konklusi %>"><%= j.konklusi %></span>
                  <span class="small text-muted"><%= namaPenyakit[j.konklusi] || '' %></span>
                </div>
              </li>
            <% }) %>
          </ol>
        <% } else { %>
          <p class="text-muted mb-0">Belum ada aturan yang seluruh premisnya terpenuhi oleh fakta awal<%= diagnosa.length ? '; hasil di atas dihitung dari gejala yang cocok sebagian' : '' %>.</p>
        <% } %>
        <p class="text-muted small mt-3 mb-0">Inferensi berhenti setelah <%= jumlahIterasi %> iterasi karena tidak ada fakta baru yang dihasilkan.</p>
      </div>
    </div>
    <% } %>
  </div>

  <div class="col-lg-4">
    <div class="card mb-3">
      <div class="card-body">
        <div class="d-flex align-items-center gap-3 mb-3">
          <span class="avatar"><%= riwayat.nama.trim().charAt(0).toUpperCase() %></span>
          <div class="lh-sm">
            <div class="fw-bold"><%= riwayat.nama %></div>
            <small class="text-muted">Pasien</small>
          </div>
        </div>
        <dl class="info-list">
          <% if (riwayat.kodePasien) { %><dt>ID Pasien</dt><dd><%= riwayat.kodePasien %></dd><% } %>
          <dt>Umur</dt><dd><%= riwayat.umur %> tahun</dd>
          <dt>Kelamin</dt><dd><%= riwayat.jenisKelamin === 'L' ? 'Laki-laki' : 'Perempuan' %></dd>
          <dt>No. Hasil</dt><dd>#<%= String(riwayat.id).padStart(5, '0') %></dd>
          <dt>Diagnosa keluar</dt><dd><%= tanggal.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %>, <%= tanggal.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) %></dd>
        </dl>
      </div>
    </div>

    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span>Gejala dipilih</span>
        <span class="badge badge-code"><%= riwayat.daftarGejala.length %></span>
      </div>
      <div class="card-body d-flex flex-wrap gap-2">
        <% riwayat.daftarGejala.forEach(g => { %>
          <span class="chip"><span class="badge badge-code"><%= g.kode %></span><%= g.nama %><% if (g.cfUser != null) { %> <small class="text-muted">(<%= labelKeyakinan[g.cfUser] || g.cfUser %>)</small><% } %></span>
        <% }) %>
      </div>
    </div>

    <p class="disclaimer"><i class="bi bi-shield-check"></i>Hasil ini bukan pengganti diagnosis dokter. Bawa hasil cetak saat berkonsultasi.</p>
  </div>
</div>
</div>

<%- include('../partials/footer') %>
