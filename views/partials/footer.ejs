<%
  const roleF = user ? user.role : null;
  const isPanelF = (roleF === 'admin' || roleF === 'dokter') &&
    (currentPath.startsWith('/admin') || currentPath.startsWith('/dokter'));
  const isBareF = typeof layout !== 'undefined' && layout === 'bare';
%>
<% if (isPanelF) { %>
    </main>
  </div>
</div>
<% } else if (!isBareF) { %>
</main>
<footer class="app-footer no-print">
  <div class="container d-flex flex-column flex-md-row gap-2 justify-content-between align-items-md-center">
    <span class="d-flex align-items-center gap-2"><span class="brand-logo" style="width:1.6rem;height:1.6rem;font-size:.85rem;border-radius:.5rem"><i class="bi bi-lungs"></i></span>&copy; <%= new Date().getFullYear() %> Lerdy Fernando Simanulang &middot; SiPakar Paru</span>
    <span>Metode Forward Chaining</span>
  </div>
</footer>
<% } %>

<!-- Modal konfirmasi (dipakai oleh form dengan atribut data-confirm) -->
<div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content">
      <div class="modal-body text-center p-4">
        <div class="icon-tile lg tone-rose mx-auto mb-3"><i class="bi bi-trash3"></i></div>
        <h5 class="fw-bold mb-2">Yakin ingin menghapus?</h5>
        <p class="text-muted small mb-4" data-confirm-text></p>
        <div class="d-grid gap-2">
          <button type="button" class="btn btn-danger" data-confirm-ok>Ya, hapus</button>
          <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Batal</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/app.js"></script>
</body>
</html>
