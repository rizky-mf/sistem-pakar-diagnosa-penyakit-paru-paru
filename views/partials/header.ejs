<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title + ' | ' : '' %>Sistem Pakar Paru</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body class="d-flex flex-column min-vh-100">
<% const role = user ? user.role : null; %>
<nav class="navbar navbar-expand-lg navbar-dark bg-primary no-print">
  <div class="container">
    <a class="navbar-brand fw-semibold" href="/"><i class="bi bi-lungs"></i> SiPakar Paru</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="nav">
      <ul class="navbar-nav me-auto">
        <li class="nav-item"><a class="nav-link <%= currentPath === '/' ? 'active' : '' %>" href="/">Beranda</a></li>
        <% if (role === 'pasien') { %>
          <li class="nav-item"><a class="nav-link <%= currentPath.startsWith('/diagnosa') ? 'active' : '' %>" href="/diagnosa">Diagnosa</a></li>
          <li class="nav-item"><a class="nav-link <%= currentPath === '/riwayat-saya' ? 'active' : '' %>" href="/riwayat-saya">Riwayat Saya</a></li>
        <% } %>
        <% if (role === 'dokter') { %>
          <li class="nav-item"><a class="nav-link <%= currentPath.startsWith('/dokter') ? 'active' : '' %>" href="/dokter">Panel Dokter</a></li>
        <% } %>
        <% if (role === 'admin') { %>
          <li class="nav-item"><a class="nav-link <%= currentPath.startsWith('/admin') ? 'active' : '' %>" href="/admin">Panel Admin</a></li>
        <% } %>
        <li class="nav-item"><a class="nav-link <%= currentPath === '/penyakit' ? 'active' : '' %>" href="/penyakit">Info Penyakit</a></li>
      </ul>
      <ul class="navbar-nav">
        <% if (user) { %>
          <li class="nav-item">
            <span class="navbar-text me-2"><i class="bi bi-person-circle"></i> <%= user.nama %>
              <span class="badge bg-light text-primary text-capitalize"><%= user.role %></span></span>
          </li>
          <li class="nav-item">
            <form action="/logout" method="POST" class="d-inline">
              <button class="btn btn-link nav-link" type="submit"><i class="bi bi-box-arrow-right"></i> Logout</button>
            </form>
          </li>
        <% } else { %>
          <li class="nav-item"><a class="nav-link" href="/login"><i class="bi bi-box-arrow-in-right"></i> Login</a></li>
          <li class="nav-item"><a class="nav-link" href="/register"><i class="bi bi-person-plus"></i> Daftar</a></li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>
<main class="container py-4 flex-grow-1">
<% if (success && success.length) { %>
  <div class="alert alert-success alert-dismissible fade show no-print"><%= success[0] %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
<% } %>
<% if (error && error.length) { %>
  <div class="alert alert-danger alert-dismissible fade show no-print"><%= error[0] %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
<% } %>
