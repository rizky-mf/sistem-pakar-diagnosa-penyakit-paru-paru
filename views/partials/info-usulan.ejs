<%# Pemberitahuan alur usulan pada form basis pengetahuan (panel dokter) %>
<% const usulanForm = typeof usulan !== 'undefined' ? usulan : null; %>
<% if (usulanForm && usulanForm.status === 'ditolak') { %>
  <div class="alert alert-danger d-flex gap-2 small">
    <i class="bi bi-x-circle-fill"></i>
    <div><strong>Usulan sebelumnya ditolak dokter ketua.</strong><% if (usulanForm.catatan) { %> Catatan: <%= usulanForm.catatan %><% } %><br>Perbaiki lalu kirim ulang.</div>
  </div>
<% } else if (usulanForm) { %>
  <div class="alert alert-warning d-flex gap-2 small">
    <i class="bi bi-hourglass-split"></i>
    <div>Anda sedang mengubah usulan yang masih <strong>menunggu validasi</strong>.</div>
  </div>
<% } else if (!isKetua) { %>
  <div class="alert alert-info d-flex gap-2 small">
    <i class="bi bi-info-circle-fill"></i>
    <div>Data akan dikirim sebagai <strong>usulan</strong> dan baru dipakai untuk diagnosa setelah disetujui dokter ketua.</div>
  </div>
<% } %>
