<%# Pembuka layout halaman login/daftar. Parameter opsional: ringkas (logo lebih kecil) %>
<% const modeRingkas = typeof ringkas !== 'undefined' && ringkas; %>
<div class="auth-page">
  <div class="auth-shell">
    <section class="auth-panel">
      <div class="auth-panel-top justify-content-end">
        <button class="btn btn-ghost btn-icon btn-sm" type="button" data-theme-toggle aria-label="Ganti tema"><i class="bi bi-moon-stars"></i></button>
      </div>

      <div class="text-center <%= modeRingkas ? 'mt-2' : 'mt-4 mt-lg-5' %>">
        <a href="/" class="auth-logo <%= modeRingkas ? 'sm' : '' %>" aria-label="SiPakar Paru"><i class="bi bi-lungs"></i></a>
        <div class="auth-app-name <%= modeRingkas ? 'sm' : '' %>">SiPakar Paru</div>
        <div class="auth-tagline">Sistem Pakar Diagnosa Penyakit Paru-Paru<br>Metode Forward Chaining &amp; Certainty Factor</div>
        <div class="accent-line"></div>
      </div>
