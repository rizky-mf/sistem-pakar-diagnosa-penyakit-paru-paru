<%- include('../../partials/header') %>
<%- include('../../partials/admin-nav') %>

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
  <h4 class="mb-0">Kelola Akun</h4>
  <a href="/admin/user/tambah" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Tambah Admin/Dokter</a>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead><tr><th>Nama</th><th>Username</th><th>Role</th><th class="d-none d-md-table-cell">JK</th><th class="d-none d-md-table-cell">Tanggal Lahir</th><th class="text-end">Aksi</th></tr></thead>
      <tbody>
        <% const warna = { admin: 'danger', dokter: 'success', pasien: 'secondary' }; %>
        <% users.forEach(u => { %>
          <tr>
            <td><%= u.nama %></td>
            <td><%= u.username %></td>
            <td><span class="badge bg-<%= warna[u.role] %> text-capitalize"><%= u.role %></span></td>
            <td class="d-none d-md-table-cell"><%= u.jenisKelamin || '-' %></td>
            <td class="d-none d-md-table-cell"><%= u.tanggalLahir ? new Date(u.tanggalLahir).toLocaleDateString('id-ID') : '-' %></td>
            <td class="text-end text-nowrap">
              <a href="/admin/user/<%= u.id %>/edit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a>
              <% if (u.id !== user.id) { %>
                <form action="/admin/user/<%= u.id %>?_method=DELETE" method="POST" class="d-inline"
                      onsubmit="return confirm('Hapus akun <%= u.username %>?')">
                  <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../../partials/footer') %>
