<%- include('partials/header') %>
<%
  const jam = new Date().getHours();
  const sapaan = jam < 11 ? 'Selamat pagi' : jam < 15 ? 'Selamat siang' : jam < 19 ? 'Selamat sore' : 'Selamat malam';
  const maks = Math.max(1, ...distribusi.data.map(d => d.jumlah));
%>

<div class="page-header">
  <div>
    <h1 class="page-title"><%= sapaan %>, <%= user.nama %></h1>
    <p class="page-subtitle">
      <%= user.role === 'admin' ? 'Ringkasan akun dan aktivitas diagnosa sistem.' : 'Ringkasan basis pengetahuan dan aktivitas diagnosa pasien.' %>
    </p>
  </div>
  <% if (user.role === 'dokter') { %>
    <a href="/dokter/rule/tambah" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Tambah Aturan</a>
  <% } else { %>
    <a href="/admin/user/tambah" class="btn btn-primary"><i class="bi bi-person-plus"></i> Tambah Akun</a>
  <% } %>
</div>

<div class="row g-3 mb-4">
  <% kartu.forEach(([label, nilai, ikon, link, tone]) => { %>
    <div class="col-6 col-xl-3">
      <a href="<%= link %>" class="card card-hover stat-card text-decoration-none h-100">
        <div class="card-body">
          <div class="icon-tile <%= tone %>"><i class="bi <%= ikon %>"></i></div>
          <div>
            <div class="stat-value"><%= nilai %></div>
            <div class="stat-label"><%= label %></div>
          </div>
        </div>
      </a>
    </div>
  <% }) %>
</div>

<div class="row g-4">
  <div class="col-xl-7">
    <div class="card card-table h-100">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span>Diagnosa terbaru</span>
        <a href="<%= base %>/riwayat" class="btn btn-ghost btn-sm">Lihat semua</a>
      </div>
      <% if (!terbaru.length) { %>
        <div class="empty-state">
          <div class="icon-tile lg tone-sky"><i class="bi bi-inbox"></i></div>
          <h6>Belum ada diagnosa</h6>
          <p class="mb-0 small">Diagnosa pasien akan muncul di sini.</p>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-modern">
            <thead><tr><th>Pasien</th><th>Hasil</th><th class="d-none d-md-table-cell">Tanggal</th><th></th></tr></thead>
            <tbody>
              <% terbaru.forEach(r => { %>
                <tr>
                  <td>
                    <div class="d-flex align-items-center gap-2">
                      <span class="avatar sm soft"><%= r.nama.trim().charAt(0).toUpperCase() %></span>
                      <div class="lh-sm">
                        <div class="cell-title"><%= r.nama %></div>
                        <div class="cell-sub"><%= r.umur %> th &middot; <%= r.jenisKelamin === 'L' ? 'Laki-laki' : 'Perempuan' %></div>
                      </div>
                    </div>
                  </td>
                  <td>
                    <% if (r.hasil.diagnosa.length) { %>
                      <% r.hasil.diagnosa.forEach(d => { %><span class="badge badge-soft me-1"><%= d.nama %></span><% }) %>
                    <% } else { %>
                      <span class="text-muted small">Tidak ada kesimpulan</span>
                    <% } %>
                  </td>
                  <td class="d-none d-md-table-cell text-muted small text-nowrap"><%= new Date(r.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %></td>
                  <td class="text-end"><a href="<%= base %>/riwayat/<%= r.id %>" class="btn btn-ghost btn-icon btn-sm" aria-label="Lihat detail"><i class="bi bi-arrow-up-right"></i></a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <div class="col-xl-5">
    <div class="card h-100">
      <div class="card-header">
        Hasil diagnosa per penyakit
        <div class="cell-sub fw-normal">Jumlah kesimpulan dari <%= distribusi.total %> diagnosa</div>
      </div>
      <div class="card-body">
        <% if (!distribusi.data.length) { %>
          <div class="empty-state py-4">
            <div class="icon-tile lg tone-violet"><i class="bi bi-bar-chart"></i></div>
            <h6>Belum ada data</h6>
            <p class="mb-0 small">Grafik akan tampil setelah ada diagnosa yang menghasilkan kesimpulan.</p>
          </div>
        <% } else { %>
          <div class="bar-list">
            <% distribusi.data.forEach(d => { %>
              <div class="bar-row" title="<%= d.nama %>: <%= d.jumlah %> diagnosa">
                <span class="lbl"><%= d.nama %></span>
                <span class="val"><%= d.jumlah %></span>
                <div class="bar-track"><div class="bar-fill" style="width: <%= (d.jumlah / maks) * 100 %>%"></div></div>
              </div>
            <% }) %>
          </div>
          <% if (distribusi.tanpaKesimpulan) { %>
            <p class="small text-muted mt-4 mb-0"><i class="bi bi-info-circle me-1"></i><%= distribusi.tanpaKesimpulan %> diagnosa tidak menghasilkan kesimpulan.</p>
          <% } %>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
