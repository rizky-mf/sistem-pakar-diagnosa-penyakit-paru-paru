<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <h1 class="page-title">Riwayat Diagnosa</h1>
    <p class="page-subtitle"><%= riwayat.length %> diagnosa tercatat dari seluruh pasien.</p>
  </div>
  <div class="input-icon" style="min-width: min(100%, 18rem)">
    <i class="bi bi-search"></i>
    <input type="search" class="form-control" placeholder="Cari pasien atau penyakit..." data-filter="#tabelRiwayat" data-filter-empty="#riwayatKosong" aria-label="Cari riwayat">
  </div>
</div>

<div class="card card-table">
  <% if (!riwayat.length) { %>
    <div class="empty-state">
      <div class="icon-tile lg tone-sky"><i class="bi bi-inbox"></i></div>
      <h6>Belum ada riwayat diagnosa</h6>
      <p class="mb-0 small">Diagnosa yang dilakukan pasien akan tercatat di sini.</p>
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="table table-modern">
        <thead>
          <tr>
            <th>Pasien</th>
            <th>Hasil</th>
            <th class="d-none d-md-table-cell">Gejala</th>
            <th class="d-none d-lg-table-cell">Tanggal</th>
            <th class="text-end">Aksi</th>
          </tr>
        </thead>
        <tbody id="tabelRiwayat">
          <% riwayat.forEach(r => { const namaHasil = r.hasil.diagnosa.map(d => d.nama).join(', '); %>
            <tr data-filter-item data-search="<%= r.nama %> <%= namaHasil %>">
              <td>
                <div class="d-flex align-items-center gap-2">
                  <span class="avatar sm soft"><%= r.nama.trim().charAt(0).toUpperCase() %></span>
                  <div class="lh-sm">
                    <div class="cell-title"><%= r.nama %></div>
                    <div class="cell-sub"><%= r.umur %> th &middot; <%= r.jenisKelamin === 'L' ? 'L' : 'P' %></div>
                  </div>
                </div>
              </td>
              <td>
                <% if (namaHasil) { %>
                  <% r.hasil.diagnosa.forEach(d => { %><span class="badge badge-soft me-1"><%= d.nama %></span><% }) %>
                <% } else { %>
                  <span class="text-muted small">Tidak ada kesimpulan</span>
                <% } %>
              </td>
              <td class="d-none d-md-table-cell"><span class="badge badge-code neutral"><%= r.gejala.length %> gejala</span></td>
              <td class="d-none d-lg-table-cell text-muted small text-nowrap"><%= new Date(r.createdAt).toLocaleString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
              <td class="text-end text-nowrap">
                <a href="<%= base %>/riwayat/<%= r.id %>" class="btn btn-ghost btn-icon btn-sm" aria-label="Lihat detail"><i class="bi bi-eye"></i></a>
                <% if (user.role === 'admin') { %>
                  <form action="<%= base %>/riwayat/<%= r.id %>?_method=DELETE" method="POST" class="d-inline"
                        data-confirm="Riwayat diagnosa milik <%= r.nama %> akan dihapus permanen.">
                    <button class="btn btn-ghost btn-icon btn-sm danger" aria-label="Hapus"><i class="bi bi-trash3"></i></button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <div class="empty-state py-4" id="riwayatKosong" hidden>
      <h6 class="mb-1">Tidak ada hasil</h6>
      <p class="mb-0 small">Coba kata kunci lain.</p>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
