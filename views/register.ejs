<%- include('partials/header', { layout: 'bare' }) %>
<%- include('partials/auth-open', { ringkas: true }) %>

<% if (errors.length) { %>
  <div class="alert alert-danger small mt-4 mb-0">
    <ul class="mb-0 ps-3"><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul>
  </div>
<% } %>

<form action="/register" method="POST" class="d-flex flex-column gap-3 mt-4">
  <div>
    <label class="form-label" for="nama">Nama Lengkap</label>
    <div class="input-icon">
      <i class="bi bi-person-vcard"></i>
      <input class="form-control" id="nama" name="nama" value="<%= old.nama || '' %>" placeholder="Nama sesuai identitas" autocomplete="name" required>
    </div>
  </div>
  <div class="row g-3">
    <div class="col-sm-6">
      <label class="form-label" for="tanggalLahir">Tanggal Lahir</label>
      <input class="form-control" id="tanggalLahir" name="tanggalLahir" type="date" value="<%= old.tanggalLahir || '' %>" required>
    </div>
    <div class="col-sm-6">
      <label class="form-label" for="jenisKelamin">Jenis Kelamin</label>
      <select class="form-select" id="jenisKelamin" name="jenisKelamin" required>
        <option value="" disabled <%= old.jenisKelamin ? '' : 'selected' %>>Pilih</option>
        <option value="L" <%= old.jenisKelamin === 'L' ? 'selected' : '' %>>Laki-laki</option>
        <option value="P" <%= old.jenisKelamin === 'P' ? 'selected' : '' %>>Perempuan</option>
      </select>
    </div>
  </div>
  <div>
    <label class="form-label" for="username">Username</label>
    <div class="input-icon">
      <i class="bi bi-at"></i>
      <input class="form-control" id="username" name="username" value="<%= old.username || '' %>" placeholder="Minimal 4 karakter" autocomplete="username" required>
    </div>
  </div>
  <div>
    <label class="form-label" for="password">Kata Sandi</label>
    <div class="input-icon has-action">
      <i class="bi bi-lock"></i>
      <input class="form-control" id="password" name="password" type="password" minlength="6" placeholder="Minimal 6 karakter" autocomplete="new-password" required>
      <button type="button" class="input-action" data-toggle-password="#password" aria-label="Tampilkan kata sandi"><i class="bi bi-eye"></i></button>
    </div>
  </div>
  <div>
    <label class="form-label" for="konfirmasi">Ulangi Kata Sandi</label>
    <div class="input-icon has-action">
      <i class="bi bi-lock"></i>
      <input class="form-control" id="konfirmasi" name="konfirmasi" type="password" minlength="6" placeholder="Ketik ulang kata sandi" autocomplete="new-password" required>
      <button type="button" class="input-action" data-toggle-password="#konfirmasi" aria-label="Tampilkan kata sandi"><i class="bi bi-eye"></i></button>
    </div>
  </div>
  <button class="btn btn-primary btn-lg w-100 mt-1" type="submit"><i class="bi bi-person-check"></i> Daftar Sekarang</button>
</form>

<div class="divider-text my-3">SUDAH PUNYA AKUN?</div>

<a href="/login" class="btn btn-outline-primary w-100 py-2"><i class="bi bi-box-arrow-in-right"></i> Masuk ke Sistem</a>

<%- include('partials/auth-close') %>
<%- include('partials/footer', { layout: 'bare' }) %>
